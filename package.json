{
  "name": "baribari-workspace",
  "private": true,
  "description": "baribari monorepo workspace (CLI + docs)",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm --filter baribari build",
    "start": "pnpm --filter baribari start",
    "dev": "pnpm --filter baribari dev",
    "typecheck": "pnpm --filter baribari typecheck",
    "check:i18n": "pnpm --filter baribari check:i18n",
    "check:i18n:strict": "pnpm --filter baribari check:i18n:strict",
    "test": "pnpm --filter baribari test",
    "test:ai-guard": "pnpm --filter baribari test:ai-guard",
    "test:speaker": "pnpm --filter baribari test:speaker",
    "test:tui-rezi": "pnpm --filter baribari test:tui-rezi",
    "test:package-root": "pnpm --filter baribari test:package-root",
    "precommit": "node scripts/pre-commit.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "fixtures:meetings": "node scripts/generate-meeting-fixtures.mjs",
    "docs:dev": "pnpm --filter baribari-docs dev",
    "docs:build": "pnpm --filter baribari-docs build",
    "docs:preview": "pnpm --filter baribari-docs preview",
    "pack:check": "node scripts/pack-check.mjs",
    "security:check": "pnpm audit --audit-level high && pnpm audit signatures"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QinYangWang/baribari.git"
  },
  "license": "MIT",
  "devDependencies": {
    "ffmpeg-static": "5.3.0",
    "node-edge-tts": "1.2.10"
  }
}
