{
  "name": "baribari",
  "version": "1.3.0",
  "description": "Real-time meeting transcription CLI (SenseVoice + VAD + speaker ID + AI + LAN share)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "baribari": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh.md",
    "README.ja.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const p='dist/index.js';let s=fs.readFileSync(p,'utf8');if(!s.startsWith('#!'))fs.writeFileSync(p,'#!/usr/bin/env node\\n'+s);\"",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "asr",
    "speech-to-text",
    "sherpa-onnx",
    "sensevoice",
    "vad",
    "meeting",
    "transcription",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QinYangWang/baribari.git"
  },
  "bugs": {
    "url": "https://github.com/QinYangWang/baribari/issues"
  },
  "homepage": "https://github.com/QinYangWang/baribari#readme",
  "license": "MIT",
  "dependencies": {
    "bionic-audio": "^1.1.1",
    "commander": "^13.1.0",
    "node-cpal": "^0.1.1",
    "sherpa-onnx-node": "^1.13.4",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
