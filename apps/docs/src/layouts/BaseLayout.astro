---
import { ClientRouter } from "astro:transitions";
import "@/assets/styles/global.css";
import BaseHead from "@/components/shell/BaseHead.astro";
import Header from "@/components/Header.astro";
import Search from "@/components/search/Search.astro";
import { SITE } from "@/lib/site-config";
import {
  getLocaleFromPath,
  LOCALE_HTML_LANG,
  type Locale,
} from "@/lib/i18n";

interface Props {
  title: string;
  description?: string;
  image?: string;
  pageType?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  locale?: Locale;
}

const {
  title,
  description = SITE.description,
  image,
  pageType,
  publishedTime,
  modifiedTime,
  tags,
  locale: localeProp,
} = Astro.props;

const locale = localeProp ?? getLocaleFromPath(Astro.url.pathname);
const htmlLang = LOCALE_HTML_LANG[locale];
---

<!doctype html>
<html lang={htmlLang} class="antialiased">
  <head>
    <BaseHead
      {title}
      {description}
      {image}
      {pageType}
      {publishedTime}
      {modifiedTime}
      {tags}
    />
    <ClientRouter />
  </head>
  <body
    class="bg-background text-foreground min-h-screen selection:bg-primary/30 selection:text-primary"
  >
    <Header {locale} />
    <slot />
    <Search />
  </body>
</html>
