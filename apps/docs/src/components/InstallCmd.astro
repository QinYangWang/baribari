---
interface Props {
  cmd: string;
  copyLabel?: string;
  copiedLabel?: string;
}

const {
  cmd,
  copyLabel = "Copy",
  copiedLabel = "Copied",
} = Astro.props;
---

<div
  class="bb-install mt-6 flex max-w-md items-stretch overflow-hidden rounded-md border border-border bg-card"
>
  <pre
    class="bb-scroll m-0 min-w-0 flex-1 overflow-x-auto px-3 py-2.5 text-sm leading-none text-foreground"
  ><code class="font-mono whitespace-nowrap">{cmd}</code></pre>
  <button
    type="button"
    class="bb-copy-btn inline-flex shrink-0 items-center justify-center border-l border-border px-3 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
    data-cmd={cmd}
    data-label-copy={copyLabel}
    data-label-copied={copiedLabel}
    aria-label={copyLabel}
  >
    <svg
      class="bb-copy-icon size-4"
      viewBox="0 0 16 16"
      fill="none"
      aria-hidden="true"
    >
      <rect
        x="5.5"
        y="5.5"
        width="7"
        height="8"
        rx="1.2"
        stroke="currentColor"
        stroke-width="1.5"></rect>
      <path
        d="M3.5 10.5V3.8A1.3 1.3 0 0 1 4.8 2.5H10"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"></path>
    </svg>
    <svg
      class="bb-check-icon size-4 hidden"
      viewBox="0 0 16 16"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M3.5 8.5 6.5 11.5 12.5 4.5"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>
</div>

<script>
  function fallbackCopy(text: string): boolean {
    try {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.style.position = "fixed";
      ta.style.left = "-9999px";
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand("copy");
      document.body.removeChild(ta);
      return ok;
    } catch {
      return false;
    }
  }

  async function copyText(text: string): Promise<boolean> {
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return true;
      }
    } catch {
      /* fall through */
    }
    return fallbackCopy(text);
  }

  function bindCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>(".bb-copy-btn").forEach((btn) => {
      if (btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";

      btn.addEventListener("click", async () => {
        const cmd = btn.dataset.cmd ?? "";
        const ok = await copyText(cmd);
        if (!ok) return;

        const copyIcon = btn.querySelector(".bb-copy-icon");
        const checkIcon = btn.querySelector(".bb-check-icon");
        const copied = btn.dataset.labelCopied ?? "Copied";
        const copy = btn.dataset.labelCopy ?? "Copy";

        copyIcon?.classList.add("hidden");
        checkIcon?.classList.remove("hidden");
        btn.setAttribute("aria-label", copied);
        btn.classList.add("text-foreground");

        window.setTimeout(() => {
          copyIcon?.classList.remove("hidden");
          checkIcon?.classList.add("hidden");
          btn.setAttribute("aria-label", copy);
          btn.classList.remove("text-foreground");
        }, 1600);
      });
    });
  }

  document.addEventListener("astro:page-load", bindCopyButtons);
  bindCopyButtons();
</script>
