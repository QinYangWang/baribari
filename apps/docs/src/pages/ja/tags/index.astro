---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE, withBase } from "@/lib/site-config";
import { getTags } from "@/lib/wiki/get-tags";

const locale = "ja" as const;
const tags = await getTags(locale);
---

<BaseLayout title={`タグ - ${SITE.name}`} {locale}>
  <main class="mx-auto max-w-3xl px-4 py-16 md:py-24" data-pagefind-body>
    <header class="mb-12">
      <h1 class="text-3xl font-bold tracking-tight md:text-4xl">タグ</h1>
      <p class="mt-3 text-muted-foreground">
        日本語ドキュメントのタグ {tags.length} 件
      </p>
    </header>

    <div class="flex flex-wrap gap-2">
      {
        tags.map(({ tag, count }) => (
          <a
            href={withBase(`/ja/tag/${tag}`)}
            class="inline-flex items-center gap-1.5 rounded-full bg-muted px-3 py-1.5 text-sm transition-colors hover:bg-primary/10 hover:text-primary"
          >
            {tag}
            <span class="text-xs text-muted-foreground">{count}</span>
          </a>
        ))
      }
    </div>
  </main>
</BaseLayout>
