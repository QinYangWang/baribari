---
import { getCollection } from "astro:content";
import WikiNavNode, { type TreeNode } from "./WikiNavNode.astro";
import { sortTreeNodes } from "@/lib/wiki/tree-utils";
import {
  type Locale,
  getLocaleFromPath,
  noteMatchesLocale,
  parseNoteId,
  wikiHref,
  categoryLabel,
  UI,
} from "@/lib/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname);
const allNotes = (await getCollection("wiki")).filter((n) =>
  noteMatchesLocale(n.id, locale),
);
const currentPath = Astro.url.pathname.replace(/\/$/, "");

function humanize(slug: string): string {
  return (
    categoryLabel(locale, slug) ||
    slug
      .split("-")
      .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
      .join(" ")
  );
}

function makeTreeNode(
  segment: string,
  isFile: boolean,
  note: (typeof allNotes)[number],
): TreeNode {
  return {
    label: isFile ? note.data.title : humanize(segment),
    href: isFile ? wikiHref(note.id) : undefined,
    children: {},
  };
}

function updateFileNode(node: TreeNode, note: (typeof allNotes)[number]): void {
  node.href = wikiHref(note.id);
  node.label = note.data.title;
}

function buildTree(notes: typeof allNotes): Record<string, TreeNode> {
  const root: Record<string, TreeNode> = {};

  for (const note of notes) {
    // Tree uses path without locale prefix so sidebar is Start / Use / ...
    const { rest } = parseNoteId(note.id);
    if (rest === "index") continue;
    const segments = rest.split("/").filter(Boolean);
    let currentLevel = root;
    for (let i = 0; i < segments.length; i++) {
      const segment = segments[i]!;
      const isFile = i === segments.length - 1;

      if (!currentLevel[segment]) {
        currentLevel[segment] = makeTreeNode(segment, isFile, note);
      } else if (isFile) {
        updateFileNode(currentLevel[segment]!, note);
      }
      currentLevel = currentLevel[segment]!.children;
    }
  }

  return root;
}

const root = buildTree(allNotes);
const sortedRootKeys = sortTreeNodes(root);
---

<nav class="space-y-0.5" aria-label={UI[locale].navigation}>
  {
    sortedRootKeys.map((key) => (
      <WikiNavNode
        node={root[key]!}
        navKey={key}
        depth={0}
        currentPath={currentPath}
        class="pb-4"
      />
    ))
  }
</nav>
